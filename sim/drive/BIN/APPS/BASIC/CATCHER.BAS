10 REM STAR CATCHER: CATCH THE STARS, DODGE THE ROCKS
20 REM 4 AND 6 (OR THE ARROWS) MOVE THE BASKET, R/S QUITS
30 REM GRAPHICS: LINE BOX PSET AT. SOUND: TONE AND PLAYWAV
40 DIM X(3),Y(3),T(3)
50 H=0
100 REM ----- TITLE: A BURST OF LINES, A FANFARE -----
110 CLS:RAD
120 FOR A=0 TO 6.2 STEP 0.2
130 LINE 121,66,121+55*COS(A),66+38*SIN(A)
140 NEXT A
150 BOX 66,58,110,17,0
160 LINE 66,58,175,58:LINE 66,74,175,74
170 AT 9,4:PRINT "STAR CATCHER";
180 AT 4,8:PRINT "ENTER: PLAY  R/S: QUIT";
190 TONE 3:TONE 5:TONE 7:TONE 9
200 REM TWINKLE IN THE CORNERS UNTIL ENTER
210 N=RND(60)-1:IF RND(2)=1 THEN N=N+190
220 PSET N,RND(80)+13,RND(2)-1
230 K$=INKEY$:IF K$<>CHR$(13) THEN WAIT 20:GOTO 210
300 REM ----- A NEW GAME -----
310 CLS:S=0:L=3:V=2:C=0:P=113:G=10
320 FOR I=0 TO 3:T(I)=0:NEXT I
330 FOR I=1 TO 40:PSET RND(250)-1,RND(80)+26:NEXT I
340 LINE 0,121,249,121
350 GOSUB 900:GOSUB 800
400 REM ----- EACH FRAME: THE KEYS, THEN EVERYTHING FALLS -----
410 K$=INKEY$:D=0
420 IF K$="4" OR K$=CHR$(30) THEN D=-12
430 IF K$="6" OR K$=CHR$(31) THEN D=12
440 IF D THEN BOX P,112,24,8,0:P=P+D:IF P<0 THEN P=0
450 IF P>226 THEN P=226
460 IF D THEN GOSUB 800
500 FOR I=0 TO 3
510 IF T(I)=0 THEN GOSUB 600:GOTO 590
520 BOX X(I)-3,Y(I)-3,7,7,0
530 Y(I)=Y(I)+V
540 IF Y(I)>=110 THEN GOSUB 700:GOTO 590
550 IF T(I)=1 THEN LINE X(I)-3,Y(I),X(I)+3,Y(I):LINE X(I),Y(I)-3,X(I),Y(I)+3
560 IF T(I)=2 THEN BOX X(I)-3,Y(I)-3,7,7,1:PSET X(I)-1,Y(I)-1,0
590 NEXT I
595 IF L=0 THEN 1000
598 WAIT 20
599 GOTO 410
600 REM ----- MAYBE A NEW STAR OR ROCK IN SLOT I -----
610 IF RND(12)>1 THEN RETURN
620 X(I)=RND(234)+7:Y(I)=29:T(I)=1
630 IF RND(10)<=2+INT(S/15) THEN T(I)=2
640 RETURN
700 REM ----- SLOT I REACHED THE BASKET'S LINE -----
710 Z=T(I):T(I)=0
720 IF X(I)<P-2 OR X(I)>P+25 THEN 770
730 IF Z=2 THEN 780
740 S=S+1:C=C+1:IF C>9 THEN C=9
750 PLAYWAV "TONES/TONE"+STR$(C)
760 IF S=G THEN GOSUB 850
765 GOSUB 900:GOSUB 800:RETURN
770 IF Z=1 THEN C=0
775 GOSUB 800:RETURN
780 L=L-1:C=0:GOSUB 950:GOSUB 900:GOSUB 800:RETURN
800 REM ----- THE BASKET -----
810 BOX P,112,24,8,0
820 LINE P,112,P+3,119:LINE P+23,112,P+20,119:LINE P+3,119,P+20,119
830 LINE P+1,115,P+22,115
840 RETURN
850 REM ----- NEXT LEVEL: FASTER, AND A JINGLE -----
860 V=V+1:G=G+10
870 AT 11,4:PRINT "LEVEL ";V-1;
880 TONE 5:TONE 7:TONE 9
890 BOX 0,61,250,12,0:RETURN
900 REM ----- SCORE, BEST, LIVES -----
910 AT 0,0:PRINT "SCORE ";S;"  ";
920 AT 13,0:PRINT "BEST ";H;"  ";
930 FOR J=0 TO 2:BOX 218+J*10,15,8,8,1:IF J>=L THEN BOX 219+J*10,16,6,6,0
940 NEXT J
945 LINE 0,25,249,25:RETURN
950 REM ----- A ROCK HIT: SPARKS AND THE ERROR SOUND -----
960 FOR A=0 TO 3.2 STEP 0.4
970 LINE X(I),111,X(I)+12*COS(A),111-12*SIN(A)
980 NEXT A
985 TONE 10
990 BOX X(I)-13,98,27,14,0:RETURN
1000 REM ----- GAME OVER: A FALLING SCALE -----
1010 IF S>H THEN H=S
1020 BOX 50,47,150,52,0
1030 LINE 50,47,199,47:LINE 199,47,199,98:LINE 199,98,50,98:LINE 50,98,50,47
1040 AT 11,3:PRINT "GAME OVER";
1050 AT 11,5:PRINT "SCORE ";S;
1060 FOR N=9 TO 0 STEP -3:TONE N:NEXT N
1070 IF INKEY$<>"" THEN 1070
1080 AT 10,6:PRINT "ENTER: AGAIN";
1090 K$=INKEY$:IF K$<>CHR$(13) THEN WAIT 20:GOTO 1090
1100 GOTO 300

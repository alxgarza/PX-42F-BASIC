10 REM SHAPES: WHAT THE CALCULATOR DRAWS. A KEY GOES ON
20 REM PEN T,C SETS THE THICKNESS AND COLOUR OF WHAT FOLLOWS
30 DEG:DIM X(5),Y(5)
100 REM ----- THE WHOLE SCREEN -----
110 CLS:PEN 1
120 BOX 0,0,250,122:LINE 0,0,249,121:LINE 0,121,249,0
130 GOSUB 900
200 REM ----- A STAR OF LINES, THEN EACH THICKNESS -----
210 CLS:PEN 1
220 FOR A=0 TO 345 STEP 15
230 LINE 69,61,INT(69.5+56*COS(A)),INT(61.5+56*SIN(A))
240 NEXT A
250 LINE 139,19,239,19
260 PEN 2:LINE 139,39,239,39
270 PEN 4:LINE 139,61,239,61
280 PEN 8:LINE 139,83,239,83
290 PEN 16:LINE 149,105,229,105
295 GOSUB 900
300 REM ----- BOXES: OUTLINES, FILLED, WHITE INSIDE -----
310 CLS
320 PEN 1:BOX 9,9,70,45
330 PEN 2:BOX 89,9,70,45
340 PEN 4:BOX 169,9,70,45
350 PEN 0:BOX 9,64,110,50:BOX 129,64,110,50
360 PEN 0,0:BOX 34,77,60,24
370 PEN 3,0:BOX 141,72,86,34
380 GOSUB 900
400 REM ----- CIRCLES AND ELLIPSES -----
410 CLS
420 PEN 1:CIRCLE 41,31,28
430 PEN 3:CIRCLE 124,31,28
440 PEN 7:CIRCLE 207,31,28
450 PEN 0:ELLIPSE 67,91,60,26
460 PEN 0,0:ELLIPSE 67,91,30,12
470 PEN 2:ELLIPSE 189,91,50,20
480 GOSUB 900
500 REM ----- POLYGONS: A FILLED STAR, WITH ITS HOLE; A HEXAGON -----
510 CLS
520 PEN 0:N=5:S=144:C=66:GOSUB 800
530 PEN 2:N=6:S=60:C=186:GOSUB 800
540 GOSUB 900
600 REM ----- A WHITE PEN ERASES: A BALL HOPS ACROSS -----
610 CLS
620 FOR D=19 TO 229 STEP 30
630 PEN 0:CIRCLE D,61,14
640 WAIT 300
650 PEN 0,0:CIRCLE D,61,14
660 NEXT D
670 END
800 REM N CORNERS, S DEGREES APART, AROUND C,62
810 A=-90
820 FOR I=0 TO N-1
830 X(I)=INT(C-0.5+50*COS(A)):Y(I)=INT(61.5+50*SIN(A))
840 A=A+S
850 NEXT I
860 POLYGON N,X,Y
870 RETURN
900 REM WAIT FOR A KEY
910 IF INKEY$="" THEN WAIT 20:GOTO 910
920 RETURN
